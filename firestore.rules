rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contenido público del portafolio: cualquiera lee, solo el admin autenticado escribe.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cvs/{lang} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
